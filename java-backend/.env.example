# VoxTicket Java backend - environment variables (java-backend/.env.example)
#
# REFERENCE ONLY. Spring Boot does not read a .env file on its own, so
# set these in PowerShell ($env:NAME='value') or in your IDE run config.
# Only the variables below are read from the environment; everything
# else (tiers, routing margins, RAG top-k, OTP limits, audit sizes) is
# in java-backend/src/main/resources/application.yaml.
# Safe to commit: placeholders and shipped dev defaults only. Never put
# a real key in a committed file.

# Profile: business endpoints need dev (or test). A plain boot serves
# only the static frontend.
SPRING_PROFILES_ACTIVE=dev

# Database: PostgreSQL with pgvector (Flyway V1-V10, JPA validate).
# Change DB_PASSWORD for any shared or deployed database.
DB_URL=jdbc:postgresql://localhost:5432/voxticket2.0
DB_USERNAME=muzammil
DB_PASSWORD=local-dev-only-not-a-real-secret

# Admin console (/api/v1/admin/**, HTTP Basic). Default admin/admin
# logs a loud startup warning; change both beyond a local demo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# LiveKit + voice telemetry (must match python-voice/.env.example).
# Leave empty for a chat-only boot. Voice needs a real project
# (LiveKit Cloud, or self-hosted ws://localhost:7880).
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret
# Empty telemetry secret = no secret required (dev only); if set, it
# must match VOICE_TELEMETRY_SECRET in python-voice/.env exactly.
# VOICE_TELEMETRY_SECRET=your-shared-telemetry-secret

# Chat LLM providers (keys from env only, never from yaml).
# Tier 1 uses GOOGLE gemini-3.5-flash-lite, Tier 2 uses GROQ
# openai/gpt-oss-120b. A tier with a blank key fails startup.
# Cerebras is enabled in yaml but no shipped tier uses it.
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
# CEREBRAS_API_KEY=your-cerebras-api-key

# Local embeddings (default).
# RAG: Ollama bge-m3 (1024 dims). Routing: local ONNX
# intfloat/multilingual-e5-small (384 dims). ROUTING_MODEL_PATH is the
# directory with model.onnx + tokenizer.json, downloaded once from
# https://huggingface.co/intfloat/multilingual-e5-small/tree/main/onnx.
# It is required when routing provider=local and strategy=HYBRID, and
# ignored when routing provider=voyage.
OLLAMA_BASE_URL=http://localhost:11434
# ROUTING_MODEL_PATH=D:\models\multilingual-e5-small

# Cloud embeddings for RAG (Voyage, 1024 dims, no pgvector migration).
# Do not set provider=voyage without a key: startup fails fast.
# Upgrade by changing VOYAGE_MODEL to voyage-4 or voyage-4-large
# (same 1024 dims); ingestion re-embeds automatically on model change.
VOXTICKET_EMBEDDING_PROVIDER=local
# VOXTICKET_EMBEDDING_PROVIDER=voyage
# VOYAGE_API_KEY=your-voyage-api-key
# VOYAGE_MODEL=voyage-4-lite
# VOYAGE_BASE_URL=https://api.voyageai.com/v1
# Per-attempt timeout in seconds (default 5). Raise only to diagnose a
# slow network (e.g. 30), then put it back: a failed turn stalls for
# the full timeout instead of failing fast.
# VOYAGE_TIMEOUT_SECONDS=30

# Cloud embeddings for routing (Voyage), independent of RAG above.
# Set provider=voyage to move routing only, or set both providers to
# voyage to move both. If the routing key / base-url / timeout below
# are left unset, routing falls back to the embedding values above,
# so normally you only need VOYAGE_API_KEY plus both providers.
VOXTICKET_ROUTING_PROVIDER=local
# VOXTICKET_ROUTING_PROVIDER=voyage
# VOYAGE_ROUTING_MODEL=voyage-4-lite
# VOYAGE_ROUTING_API_KEY=your-voyage-api-key
# VOYAGE_ROUTING_BASE_URL=https://api.voyageai.com/v1
# VOYAGE_ROUTING_TIMEOUT_SECONDS=30

# Mail: OTP delivery by email, only when delivery=email.
# With delivery=dev (default) no mail is sent and no SMTP server is
# needed. Gmail example: host smtp.gmail.com, port 587, username = your
# Gmail address, password = a Gmail app password (16 chars, no spaces),
# MAIL_FROM = the same Gmail address (Gmail rejects a mismatched From).
VOXTICKET_OTP_DELIVERY=dev
# VOXTICKET_OTP_DELIVERY=email
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-address@example.com
# MAIL_PASSWORD=your-app-password-without-spaces
# MAIL_FROM=your-address@example.com
