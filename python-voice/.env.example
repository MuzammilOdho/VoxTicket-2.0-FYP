# Copy to .env and fill in. Secrets are env-only: never commit a real key.
# The Java side needs the same LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET
# (for minting browser tokens) - see APPLICATION_YAML_SNIPPET.yaml.

# LiveKit Cloud project (recommended): create a free project at
# https://cloud.livekit.io and paste its URL + API key + secret here.
# Alternative: self-hosted server -> ws://localhost:7880 with your --dev keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Streaming STT: AssemblyAI Universal-3.6 Pro (auto en/ur + code-switching).
ASSEMBLYAI_API_KEY=
# Optional: comma-separated decoder keyterms (default biases toward VoxTicket
# vocabulary: brand name, OTP, support verbs).
# ASSEMBLYAI_KEYTERMS=VoxTicket,OTP,order,refund,delivery,tracking,payment

# Streaming TTS: Cartesia Sonic. One voice id per reply language.
CARTESIA_API_KEY=
CARTESIA_VOICE_EN=
CARTESIA_VOICE_UR=
# Cartesia model id. Urdu (ur) requires sonic-3.6+; sonic-3 cannot
# synthesize Urdu at all. Check docs.cartesia.ai for the current flagship.
CARTESIA_MODEL=sonic-3.6

# VoxTicket Java brain: blocking turn (fallback) + SSE stream (preferred).
VOXTICKET_TURN_URL=http://localhost:8080/api/v1/voice/turn
VOXTICKET_TURN_STREAM_URL=http://localhost:8080/api/v1/voice/turn/stream
BRAIN_TIMEOUT_S=25

# Spoken once when the agent joins, without creating a Java turn.
GREETING=Welcome to VoxTicket! How can I help you today?

LOG_LEVEL=INFO
