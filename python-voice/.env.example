# VoxTicket Python voice worker - environment variables
# (python-voice/.env.example)
#
# Copy to python-voice/.env and fill in the keys. The worker loads .env
# automatically (python-dotenv). Never commit a filled-in .env or a real key.
# LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET and
# VOICE_TELEMETRY_SECRET must match the Java backend's values
# (java-backend/.env.example).

# LiveKit: always required.
# Cloud: create a free project at https://cloud.livekit.io.
# Self-hosted: ws://localhost:7880 with your --dev keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Provider selection. Only the selected providers' keys are required;
# a selected provider with a missing key fails startup, naming the key.
STT_PROVIDER=assemblyai     # assemblyai | elevenlabs
TTS_PROVIDER=cartesia       # cartesia | elevenlabs | azure

# STT: AssemblyAI (required when STT_PROVIDER=assemblyai).
ASSEMBLYAI_API_KEY=
# Optional decoder keyterms, comma-separated. Default: VoxTicket,OTP,order,
# refund,delivery,tracking,payment,verification code.
# ASSEMBLYAI_KEYTERMS=VoxTicket,OTP,order,refund,delivery,tracking,payment

# STT alternative: ElevenLabs Scribe v2 Realtime (required when
# STT_PROVIDER=elevenlabs).
# ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v2_realtime
# ELEVENLABS_STT_LANGUAGE=en
# ELEVENLABS_STT_SECONDARY_LANGUAGES=ur

# TTS: Cartesia Sonic (required when TTS_PROVIDER=cartesia).
# One voice id per reply language. Urdu requires sonic-3.6+; sonic-3
# cannot synthesize Urdu.
CARTESIA_API_KEY=
CARTESIA_VOICE_EN=
CARTESIA_VOICE_UR=
CARTESIA_MODEL=sonic-3.6

# TTS alternative: ElevenLabs (required when TTS_PROVIDER=elevenlabs).
# Shares ELEVENLABS_API_KEY with the STT side. eleven_v3 supports Urdu.
# ELEVENLABS_TTS_MODEL=eleven_v3
# ELEVENLABS_VOICE_EN=
# ELEVENLABS_VOICE_UR=

# TTS alternative: Azure (required when TTS_PROVIDER=azure).
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# AZURE_VOICE_EN=en-US-AvaMultilingualNeural
# AZURE_VOICE_UR=ur-PK-AsadNeural

# Java brain: blocking turn (fallback) + SSE stream (preferred).
VOXTICKET_TURN_URL=http://localhost:8080/api/v1/voice/turn
VOXTICKET_TURN_STREAM_URL=http://localhost:8080/api/v1/voice/turn/stream
BRAIN_TIMEOUT_S=25

# Telemetry: background, best-effort, never blocks audio. Buffers
# per-turn timings and call-end events, POSTs them as JSON batches.
VOXTICKET_TELEMETRY_URL=http://localhost:8080/api/v1/voice/telemetry
VOXTICKET_HEARTBEAT_URL=http://localhost:8080/api/v1/voice/worker-heartbeat
# Shared secret, sent as X-VoxTicket-Telemetry-Secret. Must match Java.
# Empty = no secret required (dev only).
VOICE_TELEMETRY_SECRET=
TELEMETRY_FLUSH_SECONDS=5
HEARTBEAT_SECONDS=30
# Worker identity in telemetry. Default: <hostname>-<pid>.
# WORKER_ID=voice-worker-1

# Spoken once when the agent joins, without creating a Java turn.
GREETING=Welcome to VoxTicket! How can I help you today?

# Voice tuning. VAD threshold 0.0-1.0 (default 0.4). AEC warmup: seconds
# after the agent starts speaking during which caller audio is ignored
# for interruption (default 3.0). Transcription timeout: 0 disables it.
# VAD_ACTIVATION_THRESHOLD=0.4
# AEC_WARMUP_DURATION_S=3.0
# TRANSCRIPTION_TIMEOUT_S=8.0
# TRANSCRIPTION_REPROMPT=Sorry, I didn't catch that. Could you please say it again?

LOG_LEVEL=INFO
