# Copy to .env and fill in. Secrets are env-only: never commit a real key.
# The Java side needs the same LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET
# (for minting browser tokens) - see APPLICATION_YAML_SNIPPET.yaml.

# LiveKit Cloud project (recommended): create a free project at
# https://cloud.livekit.io and paste its URL + API key + secret here.
# Alternative: self-hosted server -> ws://localhost:7880 with your --dev keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Provider selection: every model is replaceable without code changes.
# Only the selected providers' keys are required; a selected provider with a
# missing key fails startup loudly (naming the key), mirroring the Java
# TierChatClientRegistry posture.
STT_PROVIDER=assemblyai     # assemblyai | elevenlabs
TTS_PROVIDER=cartesia       # cartesia | elevenlabs | azure

# Streaming STT: AssemblyAI Universal-3.6 Pro (auto en/ur + code-switching).
# Required when STT_PROVIDER=assemblyai.
ASSEMBLYAI_API_KEY=
# Optional: comma-separated decoder keyterms (default biases toward VoxTicket
# vocabulary: brand name, OTP, support verbs).
# ASSEMBLYAI_KEYTERMS=VoxTicket,OTP,order,refund,delivery,tracking,payment

# Streaming STT alternative: ElevenLabs Scribe v2 Realtime (~150ms, Urdu
# supported, language detection reported per transcript). Required when
# STT_PROVIDER=elevenlabs. A/B test vs AssemblyAI for the Urdu-vs-Hindi
# tagging question.
# ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v2_realtime
# ELEVENLABS_STT_LANGUAGE=en
# ELEVENLABS_STT_SECONDARY_LANGUAGES=ur

# Streaming TTS: Cartesia Sonic. One voice id per reply language.
# Required when TTS_PROVIDER=cartesia.
CARTESIA_API_KEY=
CARTESIA_VOICE_EN=
CARTESIA_VOICE_UR=
# Cartesia model id. Urdu (ur) requires sonic-3.6+; sonic-3 cannot
# synthesize Urdu at all. Check docs.cartesia.ai for the current flagship.
CARTESIA_MODEL=sonic-3.6

# Streaming TTS alternative: ElevenLabs. Required when TTS_PROVIDER=elevenlabs.
# Shares ELEVENLABS_API_KEY with the STT side. eleven_v3 supports Urdu;
# flash models are faster but their Urdu support is unverified.
# ELEVENLABS_TTS_MODEL=eleven_v3
# ELEVENLABS_VOICE_EN=
# ELEVENLABS_VOICE_UR=

# Streaming TTS alternative: Azure (single key, native ur-PK voices).
# Required when TTS_PROVIDER=azure. Voices have stable defaults; override
# only if you want different ones.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# AZURE_VOICE_EN=en-US-AvaMultilingualNeural
# AZURE_VOICE_UR=ur-PK-AsadNeural

# VoxTicket Java brain: blocking turn (fallback) + SSE stream (preferred).
VOXTICKET_TURN_URL=http://localhost:8080/api/v1/voice/turn
VOXTICKET_TURN_STREAM_URL=http://localhost:8080/api/v1/voice/turn/stream
BRAIN_TIMEOUT_S=25

# Spoken once when the agent joins, without creating a Java turn.
GREETING=Welcome to VoxTicket! How can I help you today?

LOG_LEVEL=INFO
